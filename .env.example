# Snipe-IT ITAM Instance URL (without trailing slash)
SNIPEIT_URL=https://assets.yourcompany.com

# Snipe-IT Personal Access Token (Generated in Snipe-IT: Account -> API Keys)
SNIPEIT_API_TOKEN=your_snipe_it_personal_access_token

# CheckWarranty API Key (Generated at https://checkwarranty.info/dashboard/api-keys)
CHECKWARRANTY_API_KEY=cw_live_your_checkwarranty_key

# CheckWarranty API Endpoint
CHECKWARRANTY_API_URL=https://checkwarranty.info/api/v1

# Sync Options
DRY_RUN=false
SYNC_SPECS=true

# Optional Snipe-IT Custom Field DB Names (Leave blank if not configured)
FIELD_CPU=
FIELD_RAM=
FIELD_STORAGE=
FIELD_DISPLAY=
